# Earth Jukebox Backend — Environment Variables
# Copy this file to .env and adjust for your setup.

# NASA GEOS-FP OPeNDAP endpoint
# Do not change this unless substituting a different GEOS-FP source.
NASA_GEOS_FP_URL=https://opendap.nccs.nasa.gov/dods/GEOS-5/fp/0.25_deg/assim/inst3_2d_asm_Nx

# CORS: comma-separated list of frontend origins allowed to call the backend.
# Adjust if your frontend dev server runs on a different port.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Backend bind address and port
HOST=127.0.0.1
PORT=8000
